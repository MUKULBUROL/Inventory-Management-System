# Database Configuration
# The database server hostname
POSTGRES_SERVER=db
# The database user (Sensitive)
DB_USER=postgres
# The database password (Sensitive - replace with secure value)
DB_PASSWORD=your_secure_password_here
# The database name
DB_NAME=inventory
# The database port
POSTGRES_PORT=5432

# Application Security
# The secret key for JWT signing (MUST CHANGE IN PRODUCTION)
SECRET_KEY=change_me_in_production

# Client Integration
# API endpoint for the frontend application
VITE_API_URL=http://localhost:8000/api/v1
